
cd C:\platform-tools

adb version

adb devices

adb shell getprop ro.build.version.release

adb shell getprop ro.product.model

adb shell getprop ro.product.manufacturer

mkdir "%USERPROFILE%\Documents\MobileForensicsLab"

cd "%USERPROFILE%\Documents\MobileForensicsLab"

echo Digital Forensics Lab Sample > sample.txt

dir

type sample.txt

adb push sample.txt /sdcard/Download/sample.txt

adb shell ls -l /sdcard/Download/sample.txt

adb shell cat /sdcard/Download/sample.txt

adb pull /sdcard/Download/sample.txt extracted_sample.txt

dir

type extracted_sample.txt

certutil -hashfile sample.txt SHA256

certutil -hashfile extracted_sample.txt SHA256

fc /b sample.txt extracted_sample.txt
